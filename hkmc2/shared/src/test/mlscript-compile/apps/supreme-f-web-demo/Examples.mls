import "../../MutMap.mls"
import "../../Predef.mls"

open Predef
module Examples with...

val examples = MutMap.empty

val diffTestPattern = new RegExp("^(?://\\u2502.*|(?://\\s*)?:.*)$\n", "gm")

fun removeDiffTests(source) =
  source.replaceAll(diffTestPattern, "").trim()

examples |> MutMap.insert of
  "identity.mls"
  name: "Identity"
  source: removeDiffTests of
    import "hkmc2/shared/src/test/mlscript/supremef/identity.mls"

examples |> MutMap.insert of
  "self-app.mls"
  name: "Self-Application"
  source: removeDiffTests of
    import "hkmc2/shared/src/test/mlscript/supremef/self-app.mls"

examples |> MutMap.insert of
  "stuck.mls"
  name: "Stuck Terms"
  source: removeDiffTests of
    import "hkmc2/shared/src/test/mlscript/supremef/stuck.mls"

examples |> MutMap.insert of
  "cond.mls"
  name: "Cond Approximation"
  source: removeDiffTests of
    import "hkmc2/shared/src/test/mlscript/supremef/cond.mls"

examples |> MutMap.insert of
  "rec1.mls"
  name: "Recursion Example 1"
  source: removeDiffTests of
    import "hkmc2/shared/src/test/mlscript/supremef/rec1.mls"

examples |> MutMap.insert of
  "rec2.mls"
  name: "Recursion Example 2"
  source: removeDiffTests of
    import "hkmc2/shared/src/test/mlscript/supremef/rec2.mls"
