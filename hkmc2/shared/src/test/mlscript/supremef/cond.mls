// Approximation via cond, which is using the `if` syntax here.
// The inferred weak type can be either an identity function or a unit.
// Note that while the identity function type shown in inferred weak types is
// not quantified using forall, we do not have any bounds for the type variable,
// so it is in fact polymorphic.
if (()) then (x => x) else ()


// Function application where the parameter can have different types due to approximation.
// The result can also have different types.
let c = if (()) then (x => x) else ()
(y => y)(c)
