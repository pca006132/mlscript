let id(x) = x in id
//│ Parsed Core Term: let id = λx. x in id
//│ Inferred: id
//│ As term: let id = λx -> x in id
//│ |> id, ∀^m2 x. x -> x ≤ id, id ≤ •
//│ ====== (1) ======
//│ Constr: id
//│ Rule: C-Promote
//│ Remaining constraints: 2
//│ ====== (2) ======
//│ Constr: ∀^m2 x. x -> x ≤ id
//│ Rule: C-Var2
//│ Remaining constraints: 1
//│ ====== (3) ======
//│ Constr: id ≤ •
//│ Rule: C-Unwrap
//│ New Constraints:
//│  id ≤ •
//│ Remaining constraints: 1
//│ ====== (4) ======
//│ Constr: id ≤ •
//│ Rule: C-Var1
//│ Premises:
//│   ∀^m2 x. x -> x ≤ id ∈ B
//│ New Constraints:
//│  ∀^m2 x0. x0 -> x0 ≤ •
//│ Remaining constraints: 1
//│ ====== (5) ======
//│ Constr: ∀^m2 x0. x0 -> x0 ≤ •
//│ Rule: C-Forall1
//│ New Constraints:
//│  x0 -> x0 ≤ •
//│ Remaining constraints: 1
//│ ====== (6) ======
//│ Constr: x0 -> x0 ≤ •
//│ Rule: C-FunForce
//│ Remaining constraints: 0
//│ ====== Final ======
//│ ------ Resolved Weak Types ------
//│ x0 -> x0

